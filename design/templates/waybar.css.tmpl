@@HEADER@@
/* Import from style.css with:  @import "zackos-theme.css"; */

@define-color zackos_background     {{ colors.background }};
@define-color zackos_background_alt {{ colors.background_alt }};
@define-color zackos_accent         {{ colors.accent }};
@define-color zackos_green          {{ colors.green }};
@define-color zackos_text           {{ colors.text }};
@define-color zackos_muted          {{ colors.muted }};
@define-color zackos_border         {{ colors.border }};
@define-color zackos_warning        {{ semantic.warning }};
@define-color zackos_error          {{ semantic.error }};
@define-color zackos_background_translucent {{ colors.background | css_rgba:effects.bar_opacity }};
