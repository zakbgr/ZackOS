@@HEADER@@
// Fastfetch reads this file from ~/.config/fastfetch/config.jsonc.
// Colors are raw 24-bit SGR bodies, so no terminal theme is required.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": { "1": "38;2;{{ colors.accent | rgbsc }}", "2": "38;2;{{ colors.green | rgbsc }}" }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;{{ colors.accent | rgbsc }}",
      "title": "38;2;{{ colors.green | rgbsc }}",
      "separator": "38;2;{{ colors.muted | rgbsc }}"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "de",
    "wm",
    "cpu",
    "gpu",
    "memory",
    "disk"
  ]
}
