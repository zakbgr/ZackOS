@@HEADER@@
# Include from kitty.conf with:  include zackos-theme.conf

font_family          {{ fonts.mono }}
font_size            {{ fonts.mono_size }}

foreground           {{ colors.text }}
background           {{ colors.background }}
background_opacity   {{ effects.terminal_opacity }}

selection_foreground {{ colors.background }}
selection_background {{ colors.accent }}

cursor               {{ colors.accent }}
cursor_text_color    {{ colors.background }}
url_color            {{ colors.accent }}
url_style            curly

# Search / mark highlights (kitty's "mark" feature): foreground is always the dark background.
mark1_foreground     {{ colors.background }}
mark1_background     {{ colors.accent }}
mark2_foreground     {{ colors.background }}
mark2_background     {{ colors.green }}
mark3_foreground     {{ colors.background }}
mark3_background     {{ semantic.warning }}

# Only used when a user turns the visual bell on (enable_audio_bell stays off in kitty.conf).
visual_bell_color    {{ semantic.warning }}

active_border_color   {{ colors.accent }}
inactive_border_color {{ colors.border }}
bell_border_color     {{ colors.green }}

tab_bar_background          {{ colors.background }}
active_tab_foreground       {{ colors.background }}
active_tab_background       {{ colors.accent }}
inactive_tab_foreground     {{ colors.muted }}
inactive_tab_background     {{ colors.background_alt }}
active_tab_font_style       bold
inactive_tab_font_style     normal

color0  {{ ansi.normal.0 }}
color1  {{ ansi.normal.1 }}
color2  {{ ansi.normal.2 }}
color3  {{ ansi.normal.3 }}
color4  {{ ansi.normal.4 }}
color5  {{ ansi.normal.5 }}
color6  {{ ansi.normal.6 }}
color7  {{ ansi.normal.7 }}
color8  {{ ansi.bright.0 }}
color9  {{ ansi.bright.1 }}
color10 {{ ansi.bright.2 }}
color11 {{ ansi.bright.3 }}
color12 {{ ansi.bright.4 }}
color13 {{ ansi.bright.5 }}
color14 {{ ansi.bright.6 }}
color15 {{ ansi.bright.7 }}
