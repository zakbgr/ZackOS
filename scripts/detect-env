# Print what ZackOS can detect about this machine. Read-only: changes nothing, needs no root.
# Run it in a terminal inside your normal desktop session and paste the output back.
set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/detect.sh
source "${REPO_ROOT}/lib/detect.sh"

detect_summary
